{
  "name": "10buy-year",
  "compatibility_date": "2026-10-06",
  // api/_telemetry.js が Buffer を参照するため
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけ Worker のコードを通し、それ以外は静的ファイルを直接返す
    "run_worker_first": ["/api/*"]
  },
  // プレイログの保存先（テーブルは migrations/0001_telemetry.sql）
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "10buy-telemetry",
      "database_id": "05ff7554-dc52-4983-a1cf-38186c0b6301",
      "migrations_dir": "migrations"
    }
  ],
  // 本番以外のブランチ（プレビュー）のビルドで `wrangler preview` を使うために必要。
  // 空なので、プレビューには本番の D1・変数・シークレットはつながらない（本番のデータに書き込まない）
  "previews": {}
}
