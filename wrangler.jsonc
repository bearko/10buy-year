{
  "name": "10buy-year",
  "compatibility_date": "2026-10-06",
  // api/_telemetry.js が Buffer を参照するため
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけ Worker のコードを通し、それ以外は静的ファイルを直接返す
    "run_worker_first": ["/api/*"]
  }
}
